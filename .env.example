# LLM used for graph extraction, query analysis/routing and answer generation.
# "ollama" (local, default) or "openrouter" (hosted, needs OPENROUTER_API_KEY).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings always come from Ollama: the whole graph is indexed with this model,
# so switching it means re-embedding every entity.
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
